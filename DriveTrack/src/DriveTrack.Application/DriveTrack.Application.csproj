<Project Sdk="Microsoft.NET.Sdk">

  <!-- AD-1: Application depends on Domain only. -->
  <ItemGroup>
    <ProjectReference Include="..\DriveTrack.Domain\DriveTrack.Domain.csproj" />
  </ItemGroup>

  <!--
    AD-9: FluentValidation 12.1.1, invoked manually. The deprecated auto-validation
    ASP.NET package is deliberately absent - validation is called by an application
    service through ValidateAndThrowAsync, never by an adapter pipeline.
    The DependencyInjectionExtensions package brings AddValidatorsFromAssembly and, with
    it, Microsoft.Extensions.DependencyInjection.Abstractions for AddApplication.
  -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!--
    AD-23's merge is internal on purpose - nothing outside this layer turns a partial payload into
    a whole one - and it is also the single most regression-prone rule in an update command:
    absent means unchanged, present-null means clear. The unit suite is where that is cheapest to
    assert, so it is the one assembly allowed to see it.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DriveTrack.Application.Tests" />
  </ItemGroup>

</Project>
