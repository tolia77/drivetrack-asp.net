@inherits LayoutComponentBase
@inject IStringLocalizer<UiText> Localizer

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-5"></div>

        <article class="content px-5">
            @* FR-13: every screen's failures pass through the one boundary. *@
            <SessionExpiryBoundary>
                @Body
            </SessionExpiryBoundary>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["CircuitError"]
    <a href="." class="reload">@Localizer["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
