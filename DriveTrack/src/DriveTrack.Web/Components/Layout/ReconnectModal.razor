@using DriveTrack.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiText> Localizer

@* ConnectionDock's second half: what the circuit says while it is trying to come back, and what it
   says once it has given up.

   Two shapes in one element, because the framework owns the element and reveals it by class. While
   it is retrying this is a dock - a bar at the foot of the screen, over nothing, so a reader can go
   on reading what they typed. Once it has given up it is a dialog, because by then there is nothing
   left on the page worth reading and the only thing to do is reload.

   The scaffold's 80px expanding-rings animation is gone: in a dock it is larger than the sentence
   beside it, and a mark that says "working" is a dot. The dot is `focus-ring-on-dark`, which is the
   one step in the palette declared to hold on this surface. *@

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <span class="components-reconnect-dot" aria-hidden="true"></span>
        <p class="components-reconnect-first-attempt-visible">
            @Localizer["ReconnectRejoining"]
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @Localizer["ReconnectRetryPrefix"] <span id="components-seconds-to-next-attempt"></span> @Localizer["ReconnectRetrySuffix"]
        </p>
        <p class="components-reconnect-failed-visible">
            @Localizer["ReconnectFailed"]<br />@Localizer["ReconnectRetryHint"]
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            @Localizer["Retry"]
        </button>
        <p class="components-pause-visible">
            @Localizer["SessionPaused"]
        </p>
        <p class="components-resume-failed-visible">
            @Localizer["ResumeFailed"]<br />@Localizer["ReconnectRetryHint"]
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            @Localizer["Resume"]
        </button>
    </div>
</dialog>
