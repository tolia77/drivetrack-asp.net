@using System.Globalization
@inject IStringLocalizer<UiText> Localizer
@inject ICurrentUser Caller
@inject NavigationManager Navigation
@implements IDisposable

@* FR-77 / FR-12 / NFR-25: the shell every screen shares.

   The role decides which destinations are worth offering, and that decision is a table
   (NavDestinations) rather than a chain of conditionals here - so Epic 4 adds a row instead of
   editing this markup. What stays here is how a destination renders, one independent @if block
   apiece, each with its own literal localizer key: LocalizationTests harvests only the literal
   indexer occurrences it can see in markup, so a key composed at run time would read as unused and
   fail the closed-catalogue test.

   FR-12 again, because it is the part worth repeating: hiding a link is a convenience. Whether a
   caller may perform an operation is settled by IAccessGuard inside the service, which runs
   whether or not the link was ever rendered. *@

@{
    // Read once per render: ICurrentUser answers from claims, and asking it per block would make
    // the menu's shape depend on how many times it was asked.
    var isSignedIn = Caller.IsAuthenticated;
    var destinations = isSignedIn ? NavDestinations.For(Caller.Role) : NavDestinations.Anonymous;
}

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @* NFR-25: the mark and the wordmark travel together, on every screen. *@
        <a class="navbar-brand" href="">
            <Icon Name="IconName.Location" />DriveTrack
        </a>
    </div>
</div>

<input type="checkbox" title="@Localizer["NavigationMenu"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (destinations.Contains(NavDestination.Home))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <Icon Name="IconName.Home" />@Localizer["NavHome"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Profile))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profile">
                    <Icon Name="IconName.Profile" />@Localizer["Profile"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Drivers))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="drivers">
                    <Icon Name="IconName.Drivers" />@Localizer["NavDrivers"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Vehicles))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="vehicles">
                    <Icon Name="IconName.Vehicles" />@Localizer["NavVehicles"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Deliveries))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="deliveries">
                    <Icon Name="IconName.Deliveries" />@Localizer["NavDeliveries"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.MyDeliveries))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-deliveries">
                    <Icon Name="IconName.Deliveries" />@Localizer["NavMyDeliveries"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Shifts))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="shifts">
                    <Icon Name="IconName.Shifts" />@Localizer["NavShifts"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.MyShifts))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-shifts">
                    <Icon Name="IconName.Shifts" />@Localizer["NavMyShifts"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Clients))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="clients">
                    <Icon Name="IconName.Clients" />@Localizer["NavClients"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Dispatchers))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dispatchers">
                    <Icon Name="IconName.Dispatchers" />@Localizer["NavDispatchers"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Chat))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="chat">
                    <Icon Name="IconName.Chat" />@Localizer["NavChat"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Reviews))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reviews">
                    <Icon Name="IconName.Reviews" />@Localizer["NavReviews"]
                </NavLink>
            </div>
        }

        @if (destinations.Contains(NavDestination.Notifications))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="notifications">
                    <Icon Name="IconName.Notifications" />@Localizer["NavNotifications"]
                </NavLink>
            </div>
        }

        @* The account actions are not destinations: they change who the caller is rather than where
           they are, so they sit outside the destination table. *@
        @if (isSignedIn)
        {
            <div class="nav-item px-3">
                <form method="post" action="/sign-out">
                    <AntiforgeryToken />
                    <button class="nav-link btn btn-link" type="submit">
                        <Icon Name="IconName.SignOut" />@Localizer["SignOut"]
                    </button>
                </form>
            </div>
        }

        @if (!isSignedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="sign-in">
                    <Icon Name="IconName.SignIn" />@Localizer["SignIn"]
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">
                    <Icon Name="IconName.Register" />@Localizer["Register"]
                </NavLink>
            </div>
        }

        @* NFR-14: the language switch, offered to every caller including an anonymous one - the
           sign-in page is a screen too, and somebody who cannot read it cannot sign in to change
           anything.

           A real form posting to /set-culture rather than an @onclick handler, and that is not a
           style choice: the language is carried by a cookie, and a Blazor Server component cannot
           write one. By the time its circuit is live the response that would have carried
           Set-Cookie finished long ago. So this copies the sign-out idiom exactly - method="post",
           an antiforgery token, and a full-page navigation that comes back in the other language.

           Each language names itself in the catalogue's own words, so the two buttons read
           "Українська / Англійська" on a Ukrainian page and "Ukrainian / English" on an English
           one. aria-current marks the one already in force; it is not disabled, because a control
           that vanishes from the tab order is a control a keyboard user cannot find again. *@
        <div class="nav-item px-3">
            <form class="nav-language" method="post" action="/set-culture" aria-label="@Localizer["Language"]">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <button class="nav-link btn btn-link" type="submit" name="culture" value="uk-UA"
                        aria-current="@(IsUkrainian ? "true" : null)">@Localizer["LanguageUkrainian"]</button>
                <button class="nav-link btn btn-link" type="submit" name="culture" value="en-US"
                        aria-current="@(IsUkrainian ? null : "true")">@Localizer["LanguageEnglish"]</button>
            </form>
        </div>
    </nav>
</div>

@code {
    // Where the switch comes back to. Read per render rather than captured once, and the
    // subscription below is what makes "per render" mean "per navigation": nothing else in this
    // component changes when the route does, so without it a caller who navigated three screens
    // deep would be sent back to the one the menu last rendered on.
    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    // The current language, read from the culture the request resolved to rather than from the
    // cookie: the cookie may hold a value the supported list refused, and what the user is actually
    // reading is what the marker has to agree with.
    private static bool IsUkrainian =>
        string.Equals(
            CultureInfo.CurrentUICulture.TwoLetterISOLanguageName,
            "uk",
            StringComparison.Ordinal);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        InvokeAsync(StateHasChanged);
}
