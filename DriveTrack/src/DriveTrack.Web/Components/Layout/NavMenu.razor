@using DriveTrack.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UiText> Localizer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DriveTrack</a>
    </div>
</div>

<input type="checkbox" title="@Localizer["NavigationMenu"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Localizer["NavHome"]
            </NavLink>
        </div>
    </nav>
</div>
