@page "/profile"
@attribute [Authorize]
@inject IUserService Users
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits CircuitScopedComponent

@* FR-5 / FR-87 / FR-88 / FR-92: what a signed-in user of any role reads about themselves, and the
   three things they can change about it.

   One screen rather than three, because they are one thing a user came here to do. Three dialogs
   rather than one form, because they are three operations with three different refusals: a name is
   a 422 on the merged row, an address can collide with another account and answer 409, and a
   password needs the current one before it will move at all.

   [Authorize] carries no roles, and there is no <AuthorizeView> anywhere below. Who may read or
   change *this* profile is decided by IAccessGuard.RequireSelf inside IUserService and nowhere else
   (AD-2, FR-12) - which is also what gives an administrator the client's half of FR-92 without a
   second guard member.

   Written as independent @if blocks rather than if/else chains: an `else` at markup level is a
   rendered text node as far as the source is concerned, and NFR-14's scan reads it as an
   untranslated word. The conditions are mutually exclusive, so the result is the same. *@

<PageTitle>@Localizer["ProfileTitle"]</PageTitle>

@* The screen's title, in the shared heading row. Nothing beside it: the three things a user can
   change here are actions on the record the card below holds rather than on the screen, so they
   stay in that card's head where the record they act on is. The wrapper is written all the same,
   because the product has one heading shape and a reader moving between screens should not be
   shown two different ways of starting a page. *@
<div class="dt-page-head mb-4">
    <h1 class="dt-type-h1">
        <Icon Name="IconName.Profile" />@Localizer["ProfileTitle"]
    </h1>
</div>

@* Rendered at page level as well as inside each dialog: a refusal the user can act on has to be
   visible whether the dialog is still open or has already been dismissed. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

@if (_profile is null)
{
    <p>@Localizer["Loading"]</p>
}

@if (_profile is not null)
{
    @* One Card: the record, its three actions in the head beside the title, and the facts in the
       body. The screen's own <h1> names the screen ("my profile"); the card names the record it
       holds, which is why the two are not the same word. *@
    <DtCard Title="@Localizer["Profile"]" Class="dt-profile-card">
        <Actions>
            <button type="button" class="btn btn-secondary btn-sm dt-profile-edit" @onclick="ShowEditAsync">
                <Icon Name="IconName.Edit" />@Localizer["Edit"]
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm dt-profile-password" @onclick="ShowPasswordAsync">
                <Icon Name="IconName.Edit" />@Localizer["ChangePassword"]
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm dt-profile-email" @onclick="ShowEmailAsync">
                <Icon Name="IconName.Edit" />@Localizer["ChangeEmail"]
            </button>
        </Actions>
        <ChildContent>
        <dl class="row">
            <dt class="col-sm-4">@Localizer["FirstName"]</dt>
            <dd class="col-sm-8">@_profile.FirstName</dd>

            <dt class="col-sm-4">@Localizer["LastName"]</dt>
            <dd class="col-sm-8">@_profile.LastName</dd>

            <dt class="col-sm-4">@Localizer["Email"]</dt>
            <dd class="col-sm-8">@_profile.Email</dd>

            @* DR-3 gives no role but a client a row to keep a number in, so the row appears exactly
               when there is one to show. *@
            @if (_profile.PhoneNumber is not null)
            {
                <dt class="col-sm-4">@Localizer["PhoneNumber"]</dt>
                <dd class="col-sm-8">@_profile.PhoneNumber</dd>
            }

            <dt class="col-sm-4">@Localizer["Role"]</dt>
            <dd class="col-sm-8">
                @* One branch per role rather than a composed key: a key built at run time is a key no
                   test can see, and the catalogue is closed against the keys components ask for in
                   both directions. *@
                @if (_profile.Role == UserRole.Admin)
                {
                    <DtBadge Variant="DtBadgeVariant.Role">@Localizer["RoleAdmin"]</DtBadge>
                }
                @if (_profile.Role == UserRole.Dispatcher)
                {
                    <DtBadge Variant="DtBadgeVariant.Role">@Localizer["RoleDispatcher"]</DtBadge>
                }
                @if (_profile.Role == UserRole.Driver)
                {
                    <DtBadge Variant="DtBadgeVariant.Role">@Localizer["RoleDriver"]</DtBadge>
                }
                @if (_profile.Role == UserRole.Client)
                {
                    <DtBadge Variant="DtBadgeVariant.Role">@Localizer["RoleClient"]</DtBadge>
                }
            </dd>

            @if (_profile.LicenseNumber is not null)
            {
                <dt class="col-sm-4">@Localizer["LicenseNumber"]</dt>
                <dd class="col-sm-8 dt-type-code">@_profile.LicenseNumber</dd>
            }
        </dl>
        </ChildContent>
    </DtCard>
}

<DtDialog @ref="_editDialog" Title="@Localizer["EditProfileTitle"]" OnClosed="ClearFailures">
    <ChildContent>
        @* Repeated inside the dialog, not only at the top of the page: a native <dialog> opened with
           showModal() sits in the top layer with everything behind it inert, so a banner rendered up
           there is invisible to the user who just pressed Save and got a 422.

           InlineFields is computed rather than written out, because the phone box is only offered
           to a client: claiming a field this render does not show would be the one way a refusal
           could go missing (FR-83). *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />
        <div class="mb-4">
            <label class="form-label" for="profile-first-name">@Localizer["FirstName"]</label>
            <input id="profile-first-name" class="form-control" @bind="_form.FirstName" />
            <DtFieldError Field="FirstName" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="profile-last-name">@Localizer["LastName"]</label>
            <input id="profile-last-name" class="form-control" @bind="_form.LastName" />
            <DtFieldError Field="LastName" Failures="_failures" />
        </div>
        @* FR-87 / DR-3: only a client has a row to store a number in, so only a client is offered
           the box. ProfileEdit.ToProfileCommand leaves the field absent for everybody else, which is
           what stops a dispatcher's own rename being refused for a number they were never shown. *@
        @if (_isClient)
        {
            <div class="mb-4">
                <label class="form-label" for="profile-phone">@Localizer["PhoneNumber"]</label>
                <input id="profile-phone" class="form-control" @bind="_form.PhoneNumber" />
                <div class="form-text">@Localizer["PhoneNumberHint"]</div>
                <DtFieldError Field="PhoneNumber" Failures="_failures" />
            </div>
        }
    </ChildContent>
    <Actions>
        @* The handler is a method rather than a lambda in the attribute: a `=>` here would close the
           tag as far as NFR-14's markup scan is concerned, and everything after it would be read as
           rendered English. *@
        @* Disabled while this save is in flight, and only this one: the circuit yields at the
           await, so a second click would dispatch a second write. Each dialog carries its own
           flag, so a save here leaves the other two dialogs alone. *@
        <button type="button" class="btn btn-secondary dt-profile-save" disabled="@_savingProfile"
                @onclick="SaveProfileAsync">
            <Icon Name="IconName.Confirm" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary dt-profile-cancel" @onclick="CloseEditAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

<DtDialog @ref="_passwordDialog" Title="@Localizer["ChangePasswordTitle"]" OnClosed="ClearFailures">
    <ChildContent>
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />
        <div class="mb-4">
            <label class="form-label" for="profile-current-password">@Localizer["CurrentPassword"]</label>
            <input id="profile-current-password" type="password" autocomplete="current-password"
                   class="form-control" @bind="_form.CurrentPassword" />
            <DtFieldError Field="CurrentPassword" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="profile-new-password">@Localizer["NewPassword"]</label>
            <input id="profile-new-password" type="password" autocomplete="new-password"
                   class="form-control" @bind="_form.NewPassword" />
            <DtFieldError Field="NewPassword" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="profile-new-password-confirmation">@Localizer["NewPasswordConfirmation"]</label>
            <input id="profile-new-password-confirmation" type="password" autocomplete="new-password"
                   class="form-control" @bind="_form.NewPasswordConfirmation" />
            <DtFieldError Field="NewPasswordConfirmation" Failures="_failures" />
        </div>
    </ChildContent>
    <Actions>
        @* The double-click that misreports rather than merely duplicating: the second click sends
           the current password the first has already replaced, and the user is told their change
           failed when it did not. *@
        <button type="button" class="btn btn-secondary dt-password-save" disabled="@_savingPassword"
                @onclick="SavePasswordAsync">
            <Icon Name="IconName.Confirm" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary dt-password-cancel" @onclick="ClosePasswordAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

<DtDialog @ref="_emailDialog" Title="@Localizer["ChangeEmailTitle"]" OnClosed="ClearFailures">
    <ChildContent>
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />
        <div class="mb-4">
            <label class="form-label" for="profile-email">@Localizer["Email"]</label>
            <input id="profile-email" type="email" class="form-control" @bind="_form.Email" />
            <DtFieldError Field="Email" Failures="_failures" />
        </div>
    </ChildContent>
    <Actions>
        @* Disabled while this save is in flight, for the same reason as the other two dialogs. *@
        <button type="button" class="btn btn-secondary dt-email-save" disabled="@_savingEmail"
                @onclick="SaveEmailAsync">
            <Icon Name="IconName.Confirm" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary dt-email-cancel" @onclick="CloseEmailAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

@code {

    /// <summary>
    /// Drops the refusals when the form is dismissed, however it was dismissed.
    /// <para>
    /// FR-83. A refusal claimed by a box inside the dialog is subtracted from the banner outside it,
    /// so leaving the list populated past the close would leave that sentence with nowhere on the
    /// page to render - invisible, which is the outcome this whole change exists to prevent.
    /// Hung off <c>OnClosed</c> rather than off the cancel handler because Escape and the backdrop
    /// dismiss the dialog too, and the component routes all three through one event.
    /// </para>
    /// </summary>
    private void ClearFailures() => _failures = [];
    private readonly ProfileEditForm _form = new();

    /// <summary>
    /// The boxes the three dialogs between them render, which is what every banner on this page
    /// subtracts. One list for all of them, because they share <c>_failures</c>: a per-dialog list
    /// would leave a password refusal showing twice - inline in its own dialog, and again in the
    /// banner of the other two.
    /// <para>
    /// The phone number joins it only for a client, for the reason DR-3 offers that box only to a
    /// client. Everything not named here still reaches the banner, which is where
    /// <c>AUTH_CURRENT_PASSWORD_INCORRECT</c> lands - the service raises it with no field at all.
    /// </para>
    /// </summary>
    private string InlineFields => _isClient
        ? "FirstName,LastName,PhoneNumber,CurrentPassword,NewPassword,NewPasswordConfirmation,Email"
        : "FirstName,LastName,CurrentPassword,NewPassword,NewPasswordConfirmation,Email";

    private DtDialog? _editDialog;
    private DtDialog? _passwordDialog;
    private DtDialog? _emailDialog;

    private UserProfile? _profile;
    private IReadOnlyList<ScreenFailure> _failures = [];
    private bool _isClient;

    // Three flags rather than one, because these are three independent dialogs: a single shared
    // flag would grey out the save in a dialog the user is not even in. The password one is the
    // case that misreports rather than merely duplicating - the second click sends the current
    // password the first click has already changed, so a change that succeeded comes back as
    // AUTH_CURRENT_PASSWORD_INCORRECT.
    private bool _savingProfile;
    private bool _savingPassword;
    private bool _savingEmail;

    protected override async Task OnInitializedAsync()
    {
        // The circuit outlives the request that opened it, so the cookie can be gone by the time a
        // screen calls a service. Raising the contract's own code here is what puts that case
        // through FR-13's single boundary instead of a per-screen redirect.
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _profile = await Users.GetProfileAsync(Caller.UserId, CircuitToken);

        // Read from the profile rather than from ICurrentUser: the two agree, and the one the screen
        // renders is the one it should decide from.
        _isClient = _profile.Role == UserRole.Client;
    }

    private async Task ShowEditAsync()
    {
        if (_profile is null)
        {
            return;
        }

        _failures = [];

        _form.Fill(_profile);

        if (_editDialog is not null)
        {
            await _editDialog.ShowAsync();
        }
    }

    private async Task ShowPasswordAsync()
    {
        _failures = [];

        // Never pre-filled: only a hash is stored (FR-8), so there is nothing to pre-fill them with.
        ClearPasswords();

        if (_passwordDialog is not null)
        {
            await _passwordDialog.ShowAsync();
        }
    }

    private async Task ShowEmailAsync()
    {
        if (_profile is null)
        {
            return;
        }

        _failures = [];
        _form.Email = _profile.Email;

        if (_emailDialog is not null)
        {
            await _emailDialog.ShowAsync();
        }
    }

    private async Task SaveProfileAsync()
    {
        if (_savingProfile)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _savingProfile = true;

        try
        {
            await Users.UpdateProfileAsync(
                Caller.UserId,
                ProfileEdit.ToProfileCommand(
                    _form.FirstName,
                    _form.LastName,
                    _form.PhoneNumber,
                    _isClient),
                CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _savingProfile = false;
        }

        // Cleared on the way out, not only when a dialog opens: the banner is rendered at page level
        // as well as inside the dialog, so a refused attempt that is then corrected and accepted
        // would otherwise leave the failure standing on the page behind the closed dialog,
        // contradicting the values the user can see were written.
        _failures = [];

        // Outside the try, because the write has already committed by now: a refetch that failed
        // inside it would be caught and rendered as though the edit had been refused, which is the
        // one thing the user must not be told.
        await CloseEditAsync();
        await ReloadAsync();
    }

    private async Task SavePasswordAsync()
    {
        if (_savingPassword)
        {
            return;
        }

        // Set before the await and cleared in the finally. Without it the second click sends the
        // current password the first click has already changed, and a change that succeeded is
        // reported back as AUTH_CURRENT_PASSWORD_INCORRECT.
        _savingPassword = true;

        try
        {
            await Users.ChangePasswordAsync(
                Caller.UserId,
                new ChangePasswordCommand(
                    _form.CurrentPassword,
                    _form.NewPassword,
                    _form.NewPasswordConfirmation),
                CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            // A refused change must not render the submitted passwords back, exactly as the two
            // account forms do not.
            ClearPasswords();
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _savingPassword = false;
        }

        ClearPasswords();
        _failures = [];

        await ClosePasswordAsync();

        // DW-11 owns revoking the session, so nothing here signs the user out: the cookie keys on
        // the user id and survives the change. There is nothing on this screen to refetch either -
        // a password has no readable form (FR-8).
    }

    private async Task SaveEmailAsync()
    {
        if (_savingEmail)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _savingEmail = true;

        try
        {
            await Users.ChangeEmailAsync(
                Caller.UserId,
                new ChangeEmailCommand(_form.Email),
                CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _savingEmail = false;
        }

        _failures = [];

        await CloseEmailAsync();
        await ReloadAsync();
    }

    private void ClearPasswords() => _form.ClearPasswords();

    // The three closers clear the banner on the way out, and that is not tidying. The banner is
    // rendered at page level as well as inside each dialog, so a refusal followed by Cancel would
    // otherwise leave a red alert standing over values nothing changed - the page asserting a
    // failure about an edit the user abandoned.
    private async Task CloseEditAsync()
    {
        _failures = [];

        if (_editDialog is not null)
        {
            await _editDialog.CloseAsync();
        }
    }

    private async Task ClosePasswordAsync()
    {
        _failures = [];

        if (_passwordDialog is not null)
        {
            await _passwordDialog.CloseAsync();
        }
    }

    private async Task CloseEmailAsync()
    {
        _failures = [];

        if (_emailDialog is not null)
        {
            await _emailDialog.CloseAsync();
        }
    }

}
