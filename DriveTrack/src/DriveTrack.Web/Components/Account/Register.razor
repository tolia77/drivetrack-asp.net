@page "/register"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Endpoints
@* Statically rendered for the same reason as SignIn: the form POST has to be able to write the
   authentication cookie, and a circuit has no response to write it to. *@
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@inject IUserService Users
@inject IStringLocalizer<UiText> Localizer
@inject NavigationManager Navigation

<PageTitle>@Localizer["RegisterTitle"]</PageTitle>

<h1>@Localizer["RegisterTitle"]</h1>

@* AUTH_EMAIL_ALREADY_IN_USE is a 409 carrying no field, so it stays here while every refusal a
   rule states about one box moves under that box. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

<EditForm Model="Form!" FormName="register" OnValidSubmit="SubmitAsync">
    <div class="mb-4">
        <label class="form-label" for="register-first-name">@Localizer["FirstName"]</label>
        <InputText id="register-first-name" class="form-control" @bind-Value="Form!.FirstName" />
        <DtFieldError Field="FirstName" Failures="_failures" />
    </div>
    <div class="mb-4">
        <label class="form-label" for="register-last-name">@Localizer["LastName"]</label>
        <InputText id="register-last-name" class="form-control" @bind-Value="Form!.LastName" />
        <DtFieldError Field="LastName" Failures="_failures" />
    </div>
    <div class="mb-4">
        <label class="form-label" for="register-email">@Localizer["Email"]</label>
        <InputText id="register-email" class="form-control" @bind-Value="Form!.Email" />
        <DtFieldError Field="Email" Failures="_failures" />
    </div>
    <div class="mb-4">
        <label class="form-label" for="register-phone">@Localizer["PhoneNumber"]</label>
        <InputText id="register-phone" class="form-control" @bind-Value="Form!.PhoneNumber" />
        <div class="form-text">@Localizer["PhoneNumberHint"]</div>
        <DtFieldError Field="PhoneNumber" Failures="_failures" />
    </div>
    <div class="mb-4">
        <label class="form-label" for="register-password">@Localizer["Password"]</label>
        <InputText id="register-password" type="password" class="form-control" @bind-Value="Form!.Password" />
        <DtFieldError Field="Password" Failures="_failures" />
    </div>
    <div class="mb-4">
        <label class="form-label" for="register-password-confirmation">@Localizer["PasswordConfirmation"]</label>
        <InputText id="register-password-confirmation" type="password" class="form-control"
                   @bind-Value="Form!.PasswordConfirmation" />
        <DtFieldError Field="PasswordConfirmation" Failures="_failures" />
    </div>
    <button class="btn btn-secondary" type="submit">@Localizer["Register"]</button>
</EditForm>

<p class="mt-4">@Localizer["HaveAccount"] <a href="/sign-in">@Localizer["SignIn"]</a></p>

@code {
    /// <summary>
    /// The boxes this screen renders a <c>DtFieldError</c> for. Stated once and bound by every
    /// banner on the page: the list repeated per banner is exactly the drift FR-83 is broken by,
    /// and a screen carries the banner more than once because a dialog opened with showModal()
    /// leaves the page behind it inert.
    /// </summary>
    private const string InlineFields = "FirstName,LastName,Email,PhoneNumber,Password,PasswordConfirmation";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // See SignIn.razor: nullable with no initializer, because the form binder can overwrite an
    // initialized property with null (BL0008).
    [SupplyParameterFromForm]
    private RegisterInput? Form { get; set; }

    // The property is named Form because the input names the browser posts back are derived from
    // the binding expression - name="Form.Email" - while the form binder looks the model up by this
    // property's name. Different names on the two sides bind nothing, silently.
    protected override void OnInitialized() => Form ??= new RegisterInput();

    private IReadOnlyList<ScreenFailure> _failures = [];

    private async Task SubmitAsync()
    {
        try
        {
            var session = await Users.RegisterClientAsync(
                new RegisterClientCommand(
                    Form!.FirstName,
                    Form!.LastName,
                    Form!.Email,
                    Form!.PhoneNumber,
                    Form!.Password,
                    Form!.PasswordConfirmation),
                HttpContext.RequestAborted);

            await HttpContext.SignInAsync(AuthenticationSchemes.Cookie, ClaimsFactory.Build(session));

            Navigation.NavigateTo(LandingRoute.For(session.Role));
        }
        catch (DriveTrackException failure)
        {
            // See SignIn.razor: a refused post must not render the submitted password back.
            Form!.Password = null;
            Form.PasswordConfirmation = null;

            _failures = FailureKeys.For(failure);
        }
    }

    private sealed class RegisterInput
    {
        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        public string? Email { get; set; }

        public string? PhoneNumber { get; set; }

        public string? Password { get; set; }

        public string? PasswordConfirmation { get; set; }
    }
}
