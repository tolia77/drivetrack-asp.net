@typeparam TItem
@inject IStringLocalizer<UiText> Localizer

@* FR-82 / FR-84 / NFR-22: one table, three states, and none of them is a blank rectangle.

   The baseline's lists rendered nothing at all while loading and nothing at all when there was
   nothing to show, which reads identically to a broken screen. Here the three states are mutually
   exclusive and every one of them puts a row on the page.

   Written as three independent @if blocks rather than an if/else chain: an `else` at markup level
   reads to NFR-14's source scan as a rendered English word (Profile.razor already branches this
   way for the same reason), and the conditions exclude each other regardless.

   Striping and hover come from the themed Bootstrap build, not from a new rule: AD-28 themed the
   framework's own variables, so `table-striped` is already wearing the palette.

   This component does not collapse to cards on a phone, deliberately: what a row looks like once
   it stops being a row is the screen's question. A screen that wants it puts `dt-table-cards` on
   its own wrapper around this table - the block is in `_theme.scss` - and states whatever cell
   placement it wants on top of it. *@

<div class="dt-table-scroll">
    <table class="table table-sm table-striped table-hover dt-type-table">
        <thead class="dt-table-head">
            <tr>
                @HeaderTemplate
            </tr>
        </thead>
        <tbody>
            @if (IsLoading)
            {
                @* Bars where the values will be, and a sentence saying so. The bars alone are a
                   shape that means "loading" to a sighted reader and nothing at all to a screen
                   reader, which is why the status row below is not optional - and why the bars are
                   hidden from assistive technology rather than read out as empty cells. *@
                @foreach (var line in SkeletonRows)
                {
                    <tr class="dt-table-skeleton" aria-hidden="true">
                        <td colspan="99">
                            <span class="dt-skeleton"></span>
                        </td>
                    </tr>
                }

                <tr class="dt-table-status">
                    @* colspan is deliberately larger than any header this component will be given:
                       the column count is the consumer's HeaderTemplate to know, not ours, and a
                       browser clamps an over-wide span to the row's actual width. *@
                    @* role="status" belongs on the cell, not on the bars: a live region has to
                       contain the text it announces, and the bars are decoration. *@
                    <td colspan="99" class="dt-table-state" role="status">
                        @Localizer["Loading"]
                    </td>
                </tr>
            }
            @if (!IsLoading && !HasItems)
            {
                @* An icon, one sentence and the next action. The sentence is the screen's, because
                   "no deliveries match these filters" and "there are no records" are different
                   claims and only the screen knows which is true; the action is the screen's for
                   the same reason - the way out of an empty filtered list is to clear the filters,
                   and the way out of an empty roster is to create something. *@
                <tr class="dt-table-empty">
                    <td colspan="99" class="dt-table-state">
                        <Icon Name="IconName.NotFound" />
                        @if (EmptyText is null)
                        {
                            <span>@Localizer["TableEmpty"]</span>
                        }
                        @if (EmptyText is not null)
                        {
                            <span>@EmptyText</span>
                        }
                        @if (EmptyAction is not null)
                        {
                            <span class="dt-table-next">@EmptyAction</span>
                        }
                    </td>
                </tr>
            }
            @if (!IsLoading && HasItems)
            {
                @foreach (var item in Items!)
                {
                    <tr class="dt-table-row">
                        @Row(item)
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@* The note the fetched page was cut off, under the table it is about rather than above it: it is a
   fact about what is on screen, and a reader who has not looked at the rows yet has nothing to
   apply it to. Never a count and never "N of M" - the query returns no total, so the honest claim
   is which page this is. *@
@if (IsTruncated && Note is not null)
{
    <p class="dt-table-note dt-type-small" role="status">
        <Icon Name="IconName.Warning" />@Note
    </p>
}

@code {
    /// <summary>
    /// The rows. Null is treated as empty rather than as an error: a screen whose query has not
    /// answered yet holds null, and throwing there would turn a normal moment into a failure.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<TItem>? Items { get; set; }

    /// <summary>True while the rows are being fetched.</summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>The header cells. Rendered inside the component's own single header row.</summary>
    /// <remarks>
    /// Required: a table with no header row is a grid of unlabelled columns, and omitting it
    /// renders an empty &lt;tr&gt; inside the &lt;thead&gt; rather than failing.
    /// </remarks>
    [Parameter]
    [EditorRequired]
    public RenderFragment? HeaderTemplate { get; set; }

    /// <summary>One item's cells. Rendered inside a row the component owns.</summary>
    /// <remarks>Required: without it the rows branch renders N empty rows.</remarks>
    [Parameter]
    [EditorRequired]
    public RenderFragment<TItem>? RowTemplate { get; set; }

    /// <summary>
    /// Overrides the empty-state text, so a screen can say "no deliveries" rather than "nothing
    /// here". Null takes the shared default.
    /// </summary>
    [Parameter]
    public string? EmptyText { get; set; }

    /// <summary>
    /// The way out of an empty table, rendered under the sentence: Clear filters when filters
    /// caused the emptiness, or the screen's create action when nothing has been made yet. Null
    /// renders nothing, because a table that is empty for a role with no actions should show none.
    /// </summary>
    [Parameter]
    public RenderFragment? EmptyAction { get; set; }

    /// <summary>
    /// True when the fetched page came back full, so there may be rows the screen is not showing.
    /// The screen decides, because only it knows which query it asked and what limit that query
    /// has; the table decides what saying so looks like.
    /// </summary>
    [Parameter]
    public bool IsTruncated { get; set; }

    /// <summary>
    /// What to say when it was cut off, in the screen's own words - a fleet, a list of deliveries
    /// and a log of notification attempts are three different things to be missing some of. Bound
    /// unconditionally rather than only when <see cref="IsTruncated"/> is true, so the sentence is
    /// a literal localizer lookup in the screen's markup and stays visible to the closed-catalogue
    /// test.
    /// </summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>
    /// How many bars the loading state draws. Two: enough for the shape of a table to be legible
    /// before the rows arrive, few enough that the page does not jump when the real rows replace
    /// them. A range rather than a repeat count because Razor iterates, it does not loop.
    /// </summary>
    private static readonly int[] SkeletonRows = [1, 2];

    private bool HasItems => Items is { Count: > 0 };

    /// <summary>
    /// One item's cells, or nothing when no template was supplied. Routed through a method rather
    /// than written as `@@RowTemplate?.Invoke(item)` in markup: NFR-14's scan strips a Razor
    /// expression only up to its first closing bracket, so the `.Invoke(...)` tail would be left
    /// behind in the text node and read as a rendered English word.
    /// </summary>
    private RenderFragment? Row(TItem item) => RowTemplate?.Invoke(item);
}
