@page "/notifications"
@attribute [Authorize]
@inject INotificationLogService Log
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits CircuitScopedComponent

@* FR-28: the row an administrator can read.

   The original swallowed a failed notification silently, and this screen is the other half of the
   remediation - a table with a home is only a remediation if somebody can open it. Every attempt is
   here, the ones that worked as well as the ones that did not: recording only failures would leave
   "no row" meaning either "nothing was owed" or "it worked", which is the ambiguity somebody opens
   this page to resolve.

   [Authorize] carries no roles, like every other screen here. Who may read this is decided by
   IAccessGuard inside INotificationLogService - RequireRole(Admin), named outright - and a role on
   the attribute would be a second copy of that rule in a place no test of the rule would read
   (AD-2, FR-12).

   Independent @if blocks and one literal localizer key per string, for the two reasons the shell
   components already state: an `else` at markup level reads to NFR-14's scan as a rendered English
   word, and a key composed at run time is a key the closed-catalogue test cannot see. *@

<PageTitle>@Localizer["NotificationsTitle"]</PageTitle>

<h1 class="dt-type-h1">
    <Icon Name="IconName.Notifications" />@Localizer["NotificationsTitle"]
</h1>

<DtFailureBanner Failures="_failures" />

@* NFR-27 keeps the original's paging, and this screen asks for the first page - so past a full page
   the older attempts are neither shown nor findable. Saying so is the difference between a limit and
   a screen that quietly lies about what the system has sent. *@
<DtDataTable TItem="NotificationAttemptSummary"
             IsTruncated="IsTruncated"
             Note="@Localizer["NotificationsTruncated"]"
             Items="_attempts"
             IsLoading="_isLoading"
             EmptyText="@Localizer["NotificationsEmpty"]">
    <HeaderTemplate>
        <th scope="col">@Localizer["NotificationDelivery"]</th>
        <th scope="col">@Localizer["NotificationKind"]</th>
        <th scope="col">@Localizer["NotificationRecipient"]</th>
        <th scope="col">@Localizer["NotificationOutcome"]</th>
        <th scope="col">@Localizer["NotificationAttemptedAt"]</th>
        <th scope="col">@Localizer["NotificationError"]</th>
    </HeaderTemplate>
    <RowTemplate Context="attempt">
        <td class="dt-notification-delivery">@attempt.DeliveryId</td>
        <td>
            @* AD-18 / FR-16: the enum member is what the database stores and the wire carries
               (AD-21); what a reader sees is a word. There is one kind today, so there is one
               block - a second joins it the day a second kind is written. *@
            @if (attempt.Kind == NotificationKind.StatusChange)
            {
                <span>@Localizer["NotificationKindStatusChange"]</span>
            }
        </td>
        <td class="dt-notification-recipient">@attempt.Recipient</td>
        <td>
            @* Sent and Failed are a status, not a badge: a closed two-value vocabulary with an
               outcome, which is the same shape a shift's running/finished is - so they wear the
               shared StatusLabel and its delivered and failed faces, and the tint comes from the
               palette's own status steps rather than from a rule written beside this table.

               A label apiece rather than one element whose face is computed, for the reason every
               other vocabulary on this product states: a key composed at run time is a key the
               closed-catalogue test cannot see. The `dt-notification-*` classes stay as the hooks
               the suite counts the two outcomes by. *@
            @if (attempt.Outcome == NotificationOutcome.Sent)
            {
                <DtStatusLabel Face="DtStatusFace.Delivered" Class="dt-notification-sent">@Localizer["NotificationSent"]</DtStatusLabel>
            }
            @if (attempt.Outcome == NotificationOutcome.Failed)
            {
                <DtStatusLabel Face="DtStatusFace.Failed" Class="dt-notification-failed">@Localizer["NotificationFailed"]</DtStatusLabel>
            }
        </td>
        @* Routed through a method rather than formatted in markup: NFR-14's scan strips a Razor
           expression only up to its first closing bracket, so a `.ToString(...)` tail would be left
           behind in the text node and read as a rendered English word. *@
        <td>@Attempted(attempt)</td>
        <td class="dt-notification-error">@attempt.Error</td>
    </RowTemplate>
</DtDataTable>

@code {
    private IReadOnlyList<NotificationAttemptSummary>? _attempts;
    private IReadOnlyList<ScreenFailure> _failures = [];
    private bool _isLoading = true;

    /// <summary>
    /// The page this screen asks for. One page of a hundred, like every other list in the product:
    /// PRD section 8 excludes server-side filtering and result counts, so the screen reads a page
    /// and shows it.
    /// </summary>
    private static ListNotificationAttemptsQuery Page =>
        new(0, ListNotificationAttemptsQueryValidator.MaximumLimit);

    /// <summary>
    /// True when the page came back full, which is as much as this screen can know: the query
    /// returns no total (PRD section 8 excludes one), so "there may be more" is the honest claim
    /// rather than a count.
    /// </summary>
    private bool IsTruncated => _attempts?.Count >= ListNotificationAttemptsQueryValidator.MaximumLimit;

    protected override async Task OnInitializedAsync()
    {
        // The circuit outlives the request that opened it, so the cookie can be gone by the time a
        // screen calls a service. Raising the contract's own code here is what puts that case
        // through FR-13's single boundary instead of a per-screen redirect.
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        await ReloadAsync();
    }

    /// <summary>
    /// The attempt's instant in local time (AD-13: storage is offset zero, and the conversion
    /// happens here, in the presentation layer, and nowhere else).
    /// </summary>
    private static string Attempted(NotificationAttemptSummary attempt) =>
        attempt.AttemptedAt.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture);

    private async Task ReloadAsync()
    {
        _isLoading = true;

        // Rendered before the await, or the flag is set and cleared inside one synchronous stretch
        // and DtDataTable's loading row never reaches the browser.
        StateHasChanged();

        try
        {
            _attempts = await Log.ListAsync(Page, CircuitToken);
            _failures = [];
        }
        catch (DriveTrackException failure)
        {
            // A dispatcher who typed the address reaches the guard's refusal here rather than a
            // blank page, and it resolves through the same catalogue the REST envelope uses, so the
            // two cannot disagree (NFR-3).
            _failures = FailureKeys.For(failure);
        }
        finally
        {
            // In a finally so a refused or failed read leaves the table in its empty state rather
            // than spinning forever, which reads to a user as a hung screen.
            _isLoading = false;
        }
    }
}
