@page "/clients"
@attribute [Authorize]
@inject IClientAdministrationService Roster
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits CircuitScopedComponent

@* FR-46 / FR-47 / FR-48: the client roster, and the two operations an administrator performs on it.

   [Authorize] carries no roles on purpose. Who may open this screen, and who may change what is on
   it, is decided by IAccessGuard inside IClientAdministrationService - reads are dispatcher-or-admin
   so FR-48 works, writes are admin. A role on the attribute would be a second copy of that rule,
   worded slightly differently, in a place no test of the rule would read (AD-2, FR-12).

   Independent @if blocks and one literal localizer key per string, for the two reasons the shell
   components already state: an `else` at markup level reads to NFR-14's scan as a rendered English
   word, and a key composed at run time is a key the closed-catalogue test cannot see. *@

<PageTitle>@Localizer["ClientsTitle"]</PageTitle>

@* The screen's title, in the heading row every other screen carries. This one holds nothing
   beside it: the roster is opened, edited and deleted from its own rows, and there is no action
   here that is about the collection rather than about a client in it.

   The wrapper is written all the same, and it does change the spacing: `.dt-page-head h1` zeroes
   the heading's own 0.5rem margin and `mb-4` replaces it with `$dt-space-4`, which this project's
   `$dt-spacers` puts at 1rem - so the gap under the title doubles. That is the point rather than
   a side effect. The gap is now the one every other screen's title sits above, and one heading
   shape across the product is worth more than this screen keeping its own. *@
<div class="dt-page-head mb-4">
    <h1 class="dt-type-h1">
        <Icon Name="IconName.Clients" />@Localizer["ClientsTitle"]
    </h1>
</div>

@* What the dialog's boxes have not claimed: a delete refusal, and AUTH_EMAIL_ALREADY_IN_USE, which
   is a 409 naming no field. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

@* The wrapper is this screen's anchor into the table it does not own: below the phone breakpoint
   the rows stop being rows and become cards, and the elements that have to change - the table, its
   head and its rows - are DtDataTable's and carry that component's scope rather than this one's. A
   scoped element around it is what gives `::deep` something to hang from. *@
<div class="dt-clients">
    <DtDataTable TItem="ClientAccount" Items="_clients" IsLoading="_isLoading">
        <HeaderTemplate>
            <th scope="col">@Localizer["FirstName"]</th>
            <th scope="col">@Localizer["LastName"]</th>
            <th scope="col">@Localizer["Email"]</th>
            <th scope="col">@Localizer["PhoneNumber"]</th>
            @* The actions column keeps its name for a screen reader and drops it on screen, as
               every other table in the product does: the buttons under it say what they do, and a
               column named above them competes with them for the same width. *@
            <th scope="col" class="dt-table-actions">
                <span class="dt-visually-hidden">@Localizer["Actions"]</span>
            </th>
        </HeaderTemplate>
        <RowTemplate Context="client">
            @* The per-cell name, carried by the cell rather than only by the column heading. Not
               the same thing on both sides of the breakpoint: above it the span is dropped, where
               the `<th>` already names the column and a second name in every cell would be that
               name read twice a row; below it the head is gone and the span is painted, as
               something a reader can see, and that is what replaces it. *@
            <td>
                <span class="dt-visually-hidden dt-client-label">@Localizer["FirstName"]</span>
                @client.FirstName
            </td>
            <td>
                <span class="dt-visually-hidden dt-client-label">@Localizer["LastName"]</span>
                @client.LastName
            </td>
            <td>
                <span class="dt-visually-hidden dt-client-label">@Localizer["Email"]</span>
                @client.Email
            </td>
            <td>
                <span class="dt-visually-hidden dt-client-label">@Localizer["PhoneNumber"]</span>
                @client.PhoneNumber
            </td>
            @* `dt-table-actions` rather than a class of this screen's own: the right-aligned,
               nowrapped actions column is DtDataTable's own rule, and the cell has to wear the
               class its heading already wears to be reached by it. *@
            <td class="dt-table-actions">
                @* FR-48 brings a dispatcher to this screen to read the roster, and both writes
                   behind these buttons are RequireRole(Admin) - so for a dispatcher they could
                   only ever fail. Offering an action that cannot succeed is worse than not
                   offering it.

                   FR-12 unchanged: this hides, it does not decide. IAccessGuard inside the service
                   is still what refuses the write, and it runs whether or not the button was
                   rendered.

                   The handler is built in C# rather than written as a lambda in the attribute: a
                   `=>` here would close the tag as far as NFR-14's markup scan is concerned, and
                   everything after it would be read as rendered English. *@
                @if (_isAdmin)
                {
                    @* The cell's own name goes inside the same branch as the buttons it names: for
                       a dispatcher this cell is empty, and a phone card showing a heading with
                       nothing under it is worse than a card with one line fewer. *@
                    <span class="dt-visually-hidden dt-client-label">@Localizer["Actions"]</span>
                    <button type="button" class="btn btn-secondary btn-sm dt-client-edit" @onclick="Edit(client)">
                        <Icon Name="IconName.Edit" />@Localizer["Edit"]
                    </button>
                    <button type="button" class="btn btn-danger btn-sm dt-client-delete" @onclick="Remove(client)">
                        <Icon Name="IconName.Delete" />@Localizer["Delete"]
                    </button>
                }
            </td>
        </RowTemplate>
    </DtDataTable>
</div>

<DtDialog @ref="_editDialog" Title="@Localizer["EditClientTitle"]" OnClosed="ClearFailures">
    <ChildContent>
        @* Repeated inside the dialog, not only at the top of the page: a native <dialog> opened with
           showModal() sits in the top layer with everything behind it inert, so a banner rendered up
           there is invisible to the administrator who just pressed Save and got a 422. *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />
        <div class="mb-4">
            <label class="form-label" for="client-first-name">@Localizer["FirstName"]</label>
            <input id="client-first-name" class="form-control" @bind="_form.FirstName" />
            <DtFieldError Field="FirstName" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="client-last-name">@Localizer["LastName"]</label>
            <input id="client-last-name" class="form-control" @bind="_form.LastName" />
            <DtFieldError Field="LastName" Failures="_failures" />
        </div>
        @* FR-92's administrator half, in the dialog that already edits the rest of the account: one
           Save, one transaction, so a taken address takes the name back with it (AD-5). *@
        <div class="mb-4">
            <label class="form-label" for="client-email">@Localizer["Email"]</label>
            <input id="client-email" type="email" class="form-control" @bind="_form.Email" />
            <DtFieldError Field="Email" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="client-phone">@Localizer["PhoneNumber"]</label>
            <input id="client-phone" class="form-control" @bind="_form.PhoneNumber" />
            <DtFieldError Field="PhoneNumber" Failures="_failures" />
            <div class="form-text">@Localizer["PhoneNumberHint"]</div>
        </div>
        <div class="mb-4">
            <label class="form-label" for="client-password">@Localizer["Password"]</label>
            @* new-password, so a browser does not offer the signed-in administrator's own saved
               password for somebody else's account. *@
            <input id="client-password" type="password" autocomplete="new-password"
                   class="form-control" @bind="_form.Password" />
            <DtFieldError Field="Password" Failures="_failures" />
            @* FR-50 / AD-23: an empty box is the absent case, which is why it does not have to be
               spelled as a magic empty string anywhere below. *@
            <div class="form-text">@Localizer["PasswordUnchangedHint"]</div>
        </div>
    </ChildContent>
    <Actions>
        @* Disabled while a save is in flight: the circuit yields at the await, so a second click
           would send the same edit again. *@
        <button type="button" class="btn btn-secondary dt-client-save" disabled="@_saving"
                @onclick="SaveAsync">
            <Icon Name="IconName.Confirm" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary dt-client-cancel" @onclick="CancelEditAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

<DtConfirmDialog @ref="_deleteDialog"
                 Title="@Localizer["DeleteClientTitle"]"
                 Message="@Localizer["DeleteClientMessage"]"
                 OnConfirmed="DeleteAsync" />

@code {

    /// <summary>
    /// Drops the refusals when the form is dismissed, however it was dismissed.
    /// <para>
    /// FR-83. A refusal claimed by a box inside the dialog is subtracted from the banner outside it,
    /// so leaving the list populated past the close would leave that sentence with nowhere on the
    /// page to render - invisible, which is the outcome this whole change exists to prevent.
    /// Hung off <c>OnClosed</c> rather than off the cancel handler because Escape and the backdrop
    /// dismiss the dialog too, and the component routes all three through one event.
    /// </para>
    /// </summary>
    private void ClearFailures() => _failures = [];
    /// <summary>
    /// The boxes this screen renders a <c>DtFieldError</c> for. Stated once and bound by every
    /// banner on the page: the list repeated per banner is exactly the drift FR-83 is broken by,
    /// and a screen carries the banner more than once because a dialog opened with showModal()
    /// leaves the page behind it inert.
    /// </summary>
    private const string InlineFields = "FirstName,LastName,Email,PhoneNumber,Password";

    private readonly ClientEditForm _form = new();

    private DtDialog? _editDialog;
    private DtConfirmDialog? _deleteDialog;

    private IReadOnlyList<ClientAccount>? _clients;
    private ClientAccount? _selected;
    private IReadOnlyList<ScreenFailure> _failures = [];
    private bool _isLoading = true;
    private bool _isAdmin;

    /// <summary>
    /// True while a save is in flight, which is what disables the save button for as long as it
    /// lasts. The circuit yields at the await, so without it a second click would send the same
    /// edit again.
    /// </summary>
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        // The circuit outlives the request that opened it, so the cookie can be gone by the time a
        // screen calls a service. Raising the contract's own code here is what puts that case
        // through FR-13's single boundary instead of a per-screen redirect.
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        // Read once, after the authenticated check: ICurrentUser.Role throws for an anonymous
        // caller, so asking outside that branch would take the screen down instead of refusing it.
        _isAdmin = Caller.Role == UserRole.Admin;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;

        // Rendered before the await, or the flag is set and cleared inside one synchronous stretch
        // and DtDataTable's loading row never reaches the browser on a post-write refetch.
        StateHasChanged();

        try
        {
            _clients = await Roster.ListAsync(CircuitToken);
        }
        finally
        {
            // In a finally so a refused or failed read leaves the table in its empty state rather
            // than spinning forever, which reads to a user as a hung screen.
            _isLoading = false;
        }
    }

    private Func<Task> Edit(ClientAccount client) => () => ShowEditAsync(client);

    private Func<Task> Remove(ClientAccount client) => () => ShowDeleteAsync(client);

    private async Task ShowEditAsync(ClientAccount client)
    {
        _selected = client;
        _failures = [];

        // Including the password, which Fill always clears: only a hash is stored (FR-8), so there
        // is nothing to pre-fill it with, and an empty box is exactly what "leave it alone" means.
        _form.Fill(client);

        if (_editDialog is not null)
        {
            await _editDialog.ShowAsync();
        }
    }

    private async Task ShowDeleteAsync(ClientAccount client)
    {
        _selected = client;
        _failures = [];

        if (_deleteDialog is not null)
        {
            await _deleteDialog.ShowAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_selected is null)
        {
            return;
        }

        if (_saving)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _saving = true;

        try
        {
            await Roster.UpdateAsync(_selected.UserId, _form.ToCommand(), CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            // A refused edit must not render the submitted password back, exactly as the two
            // account forms do not.
            _form.Password = null;
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _saving = false;
        }

        // Cleared on the way out, not only when a dialog opens: the banner is rendered at page
        // level as well as inside the dialog, so a refused attempt that is then corrected and
        // accepted would otherwise leave the failure standing on the page behind the closed
        // dialog, contradicting the row the user can see was written.
        _failures = [];

        // Outside the try, because the write has already committed by now: a refetch that failed
        // inside it would be caught and rendered as though the edit had been refused, which is the
        // one thing the user must not be told.
        await CancelEditAsync();
        await ReloadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selected is null)
        {
            return;
        }

        try
        {
            await Roster.DeleteAsync(_selected.UserId, CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }

        // Cleared here too: a refused delete followed by a confirmed one would otherwise leave the
        // refusal standing above a table the row is already gone from.
        _failures = [];

        await ReloadAsync();
    }

    private async Task CancelEditAsync()
    {
        if (_editDialog is not null)
        {
            await _editDialog.CloseAsync();
        }
    }

}
