@page "/dispatchers"
@attribute [Authorize]
@inject IDispatcherAdministrationService Roster
@inject ICurrentUser Caller
@inject IStringLocalizer<UiText> Localizer
@inherits CircuitScopedComponent

@* FR-49 / FR-50: dispatcher accounts, and the first surface in the system that can make one - until
   now the startup seeder was the only thing that could.

   Every operation here is admin-only, and that is settled by IAccessGuard inside the service rather
   than by a role on the attribute (AD-2). The navigation offers this destination to an administrator
   and to nobody else, which is a convenience on top of the same decision, not a second copy of it. *@

<PageTitle>@Localizer["DispatchersTitle"]</PageTitle>

@* The screen's title and the one action that opens an empty form, on one line - the shape every
   other screen with a create action settled. The action is about the roster rather than about any
   dispatcher in it, so it belongs beside the heading that names the roster; before this it sat in
   a bare `<p>` of its own, a loose row the dispatch-board story logged as the last divergence.

   The hook stays `dt-dispatcher-new` even though every other screen's reads `-create`: the create
   *dialog's* confirm button already owns that name here, and renaming either is a suite failure by
   design. *@
<div class="dt-page-head mb-4">
    <h1 class="dt-type-h1">
        <Icon Name="IconName.Dispatchers" />@Localizer["DispatchersTitle"]
    </h1>

    <button type="button" class="btn btn-primary dt-dispatcher-new" @onclick="ShowCreateAsync">
        <Icon Name="IconName.Create" />@Localizer["Create"]
    </button>
</div>

@* One list for both dialogs, because they share _failures: a per-dialog list would leave a name
   refusal showing twice, inline in the dialog that raised it and again in the other's banner. The
   edit dialog has no address box and no rule can name one from it (FR-92 sends a dispatcher to
   their own profile for that), so claiming Email here hides nothing. *@
<DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />

@* The wrapper is this screen's anchor into the table it does not own: below the phone breakpoint
   the rows stop being rows and become cards, and the elements that have to change - the table, its
   head and its rows - are DtDataTable's and carry that component's scope rather than this one's. A
   scoped element around it is what gives `::deep` something to hang from. *@
<div class="dt-dispatchers">
    <DtDataTable TItem="DispatcherAccount" Items="_dispatchers" IsLoading="_isLoading">
        <HeaderTemplate>
            <th scope="col">@Localizer["FirstName"]</th>
            <th scope="col">@Localizer["LastName"]</th>
            <th scope="col">@Localizer["Email"]</th>
            @* The actions column keeps its name for a screen reader and drops it on screen, as
               every other table in the product does: the buttons under it say what they do, and a
               column named above them competes with them for the same width. *@
            <th scope="col" class="dt-table-actions">
                <span class="dt-visually-hidden">@Localizer["Actions"]</span>
            </th>
        </HeaderTemplate>
        <RowTemplate Context="dispatcher">
            @* The per-cell name, carried by the cell rather than only by the column heading. Not
               the same thing on both sides of the breakpoint: above it the span is dropped, where
               the `<th>` already names the column and a second name in every cell would be that
               name read twice a row; below it the head is gone and the span is painted, as
               something a reader can see, and that is what replaces it. *@
            <td>
                <span class="dt-visually-hidden dt-dispatcher-label">@Localizer["FirstName"]</span>
                @dispatcher.FirstName
            </td>
            <td>
                <span class="dt-visually-hidden dt-dispatcher-label">@Localizer["LastName"]</span>
                @dispatcher.LastName
            </td>
            <td>
                <span class="dt-visually-hidden dt-dispatcher-label">@Localizer["Email"]</span>
                @dispatcher.Email
            </td>
            @* `dt-table-actions` rather than a class of this screen's own: the right-aligned,
               nowrapped actions column is DtDataTable's own rule, and the cell has to wear the
               class its heading already wears to be reached by it. *@
            <td class="dt-table-actions">
                <span class="dt-visually-hidden dt-dispatcher-label">@Localizer["Actions"]</span>
                <button type="button" class="btn btn-secondary btn-sm dt-dispatcher-edit" @onclick="Edit(dispatcher)">
                    <Icon Name="IconName.Edit" />@Localizer["Edit"]
                </button>
                <button type="button" class="btn btn-danger btn-sm dt-dispatcher-delete" @onclick="Remove(dispatcher)">
                    <Icon Name="IconName.Delete" />@Localizer["Delete"]
                </button>
            </td>
        </RowTemplate>
    </DtDataTable>
</div>

<DtDialog @ref="_createDialog" Title="@Localizer["CreateDispatcherTitle"]" OnClosed="ClearFailures">
    <ChildContent>
        @* Repeated inside the dialog, not only at the top of the page: a native <dialog> opened with
           showModal() sits in the top layer with everything behind it inert, so a banner rendered up
           there is invisible to the administrator who just pressed Create and got a 409. That 409
           - AUTH_EMAIL_ALREADY_IN_USE - names no field, which is why it stays in the banner while
           the shape refusals below move under their boxes. *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />
        <div class="mb-4">
            <label class="form-label" for="new-dispatcher-first-name">@Localizer["FirstName"]</label>
            <input id="new-dispatcher-first-name" class="form-control" @bind="_createForm.FirstName" />
            <DtFieldError Field="FirstName" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="new-dispatcher-last-name">@Localizer["LastName"]</label>
            <input id="new-dispatcher-last-name" class="form-control" @bind="_createForm.LastName" />
            <DtFieldError Field="LastName" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="new-dispatcher-email">@Localizer["Email"]</label>
            <input id="new-dispatcher-email" class="form-control" @bind="_createForm.Email" />
            <DtFieldError Field="Email" Failures="_failures" />
            @* This is where an administrator sets the address, and the edit dialog below has no
               email field - but not because the address is fixed. FR-92 gives a dispatcher their own
               /profile to change it from, which is the route this screen points them at. An
               administrator is not locked out of it either: AD-4 makes RequireSelf read as
               "themselves, or an admin", so POST /api/users/{id}/email answers an administrator for
               any account. What FR-92 does not ask for is a second place in this screen to do it
               from, which is why the field is here and not below. *@
            <div class="form-text">@Localizer["EmailAtCreationHint"]</div>
        </div>
        <div class="mb-4">
            <label class="form-label" for="new-dispatcher-password">@Localizer["Password"]</label>
            @* new-password, so a browser does not offer the signed-in administrator's own saved
               password for the account they are opening. *@
            <input id="new-dispatcher-password" type="password" autocomplete="new-password"
                   class="form-control" @bind="_createForm.Password" />
            <DtFieldError Field="Password" Failures="_failures" />
        </div>
    </ChildContent>
    <Actions>
        @* Disabled while a creation is in flight: the circuit yields at the await, and there was no
           early return here at all, so a second click opened a second dispatcher account. *@
        <button type="button" class="btn btn-primary dt-dispatcher-create" disabled="@_creating"
                @onclick="CreateAsync">
            <Icon Name="IconName.Confirm" />@Localizer["Create"]
        </button>
        <button type="button" class="btn btn-outline-secondary dt-dispatcher-create-cancel" @onclick="CancelCreateAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

<DtDialog @ref="_editDialog" Title="@Localizer["EditDispatcherTitle"]" OnClosed="ClearFailures">
    <ChildContent>
        @* Same reason as the create dialog above: the page behind a modal is inert, so a refusal has
           to appear where the administrator is looking. *@
        <DtFailureBanner Failures="_failures" InlineFields="@InlineFields" />
        <div class="mb-4">
            <label class="form-label" for="dispatcher-first-name">@Localizer["FirstName"]</label>
            <input id="dispatcher-first-name" class="form-control" @bind="_editForm.FirstName" />
            <DtFieldError Field="FirstName" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="dispatcher-last-name">@Localizer["LastName"]</label>
            <input id="dispatcher-last-name" class="form-control" @bind="_editForm.LastName" />
            <DtFieldError Field="LastName" Failures="_failures" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="dispatcher-password">@Localizer["Password"]</label>
            <input id="dispatcher-password" type="password" autocomplete="new-password"
                   class="form-control" @bind="_editForm.Password" />
            <DtFieldError Field="Password" Failures="_failures" />
            <div class="form-text">@Localizer["PasswordUnchangedHint"]</div>
        </div>
    </ChildContent>
    <Actions>
        @* Its own flag, for the same reason the create dialog has one: this edit is a separate
           form, and a save in flight here says nothing about the dialog above. *@
        <button type="button" class="btn btn-secondary dt-dispatcher-save" disabled="@_saving"
                @onclick="SaveAsync">
            <Icon Name="IconName.Confirm" />@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary dt-dispatcher-cancel" @onclick="CancelEditAsync">
            <Icon Name="IconName.Close" />@Localizer["Cancel"]
        </button>
    </Actions>
</DtDialog>

<DtConfirmDialog @ref="_deleteDialog"
                 Title="@Localizer["DeleteDispatcherTitle"]"
                 Message="@Localizer["DeleteDispatcherMessage"]"
                 OnConfirmed="DeleteAsync" />

@code {

    /// <summary>
    /// Drops the refusals when the form is dismissed, however it was dismissed.
    /// <para>
    /// FR-83. A refusal claimed by a box inside the dialog is subtracted from the banner outside it,
    /// so leaving the list populated past the close would leave that sentence with nowhere on the
    /// page to render - invisible, which is the outcome this whole change exists to prevent.
    /// Hung off <c>OnClosed</c> rather than off the cancel handler because Escape and the backdrop
    /// dismiss the dialog too, and the component routes all three through one event.
    /// </para>
    /// </summary>
    private void ClearFailures() => _failures = [];
    /// <summary>
    /// The boxes this screen renders a <c>DtFieldError</c> for. Stated once and bound by every
    /// banner on the page: the list repeated per banner is exactly the drift FR-83 is broken by,
    /// and a screen carries the banner more than once because a dialog opened with showModal()
    /// leaves the page behind it inert.
    /// </summary>
    private const string InlineFields = "FirstName,LastName,Email,Password";

    private readonly DispatcherCreateForm _createForm = new();
    private readonly DispatcherEditForm _editForm = new();

    private DtDialog? _createDialog;
    private DtDialog? _editDialog;
    private DtConfirmDialog? _deleteDialog;

    private IReadOnlyList<DispatcherAccount>? _dispatchers;
    private DispatcherAccount? _selected;
    private IReadOnlyList<ScreenFailure> _failures = [];
    private bool _isLoading = true;

    /// <summary>
    /// True while a creation is in flight. Two flags rather than one, because the create and edit
    /// dialogs are two independent forms: a shared flag would grey out a button in a dialog the
    /// administrator is not in.
    /// </summary>
    private bool _creating;

    /// <inheritdoc cref="_creating" />
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (!Caller.IsAuthenticated)
        {
            throw new ForbiddenException(
                ErrorCode.AUTH_UNAUTHENTICATED,
                "The circuit has no authenticated caller: the session cookie is gone.");
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;

        // Rendered before the await, or the flag is set and cleared inside one synchronous stretch
        // and DtDataTable's loading row never reaches the browser on a post-write refetch.
        StateHasChanged();

        try
        {
            _dispatchers = await Roster.ListAsync(CircuitToken);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Func<Task> Edit(DispatcherAccount dispatcher) => () => ShowEditAsync(dispatcher);

    private Func<Task> Remove(DispatcherAccount dispatcher) => () => ShowDeleteAsync(dispatcher);

    private async Task ShowCreateAsync()
    {
        _failures = [];

        _createForm.FirstName = null;
        _createForm.LastName = null;
        _createForm.Email = null;
        _createForm.Password = null;

        if (_createDialog is not null)
        {
            await _createDialog.ShowAsync();
        }
    }

    private async Task ShowEditAsync(DispatcherAccount dispatcher)
    {
        _selected = dispatcher;
        _failures = [];

        _editForm.FirstName = dispatcher.FirstName;
        _editForm.LastName = dispatcher.LastName;
        _editForm.Password = null;

        if (_editDialog is not null)
        {
            await _editDialog.ShowAsync();
        }
    }

    private async Task ShowDeleteAsync(DispatcherAccount dispatcher)
    {
        _selected = dispatcher;
        _failures = [];

        if (_deleteDialog is not null)
        {
            await _deleteDialog.ShowAsync();
        }
    }

    private async Task CreateAsync()
    {
        if (_creating)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on. This handler had no early return at all, and a repeat run creates a second
        // account.
        _creating = true;

        try
        {
            await Roster.CreateAsync(
                new CreateDispatcherCommand(
                    _createForm.FirstName,
                    _createForm.LastName,
                    _createForm.Email,
                    _createForm.Password),
                CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            _createForm.Password = null;
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _creating = false;
        }

        // Cleared on the way out, not only when a dialog opens: the banner is rendered at page
        // level as well as inside the dialog, so a refused attempt that is then corrected and
        // accepted would otherwise leave the failure standing on the page behind the closed
        // dialog, contradicting the row the user can see was written.
        _failures = [];

        // Outside the try, because the account already exists by now: a refetch that failed inside
        // it would be rendered as though the creation had been refused.
        await CancelCreateAsync();
        await ReloadAsync();
    }

    private async Task SaveAsync()
    {
        if (_selected is null)
        {
            return;
        }

        if (_saving)
        {
            return;
        }

        // Set before the await and cleared in the finally: the button is disabled from the moment
        // the first click is handled until the server has answered, so a second click has nothing
        // to act on.
        _saving = true;

        try
        {
            await Roster.UpdateAsync(
                _selected.UserId,
                new UpdateDispatcherCommand(
                    Optional<string?>.Present(_editForm.FirstName),
                    Optional<string?>.Present(_editForm.LastName),

                    // FR-50: an empty box leaves the existing password signing in.
                    PasswordBox.ToOptional(_editForm.Password)),
                CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            _editForm.Password = null;
            _failures = FailureKeys.For(failure);

            return;
        }
        finally
        {
            _saving = false;
        }

        _failures = [];

        await CancelEditAsync();
        await ReloadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selected is null)
        {
            return;
        }

        try
        {
            await Roster.DeleteAsync(_selected.UserId, CircuitToken);
        }
        catch (DriveTrackException failure)
        {
            _failures = FailureKeys.For(failure);

            return;
        }

        // Cleared here too: a refused delete followed by a confirmed one would otherwise leave the
        // refusal standing above a table the row is already gone from.
        _failures = [];

        await ReloadAsync();
    }

    private async Task CancelCreateAsync()
    {
        if (_createDialog is not null)
        {
            await _createDialog.CloseAsync();
        }
    }

    private async Task CancelEditAsync()
    {
        if (_editDialog is not null)
        {
            await _editDialog.CloseAsync();
        }
    }

    /// <summary>What the create dialog is bound to.</summary>
    private sealed class DispatcherCreateForm
    {
        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        public string? Email { get; set; }

        public string? Password { get; set; }
    }

    /// <summary>What the edit dialog is bound to. No email: story 7.3 owns that (FR-87).</summary>
    private sealed class DispatcherEditForm
    {
        public string? FirstName { get; set; }

        public string? LastName { get; set; }

        public string? Password { get; set; }
    }
}
