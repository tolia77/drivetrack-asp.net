@using Microsoft.AspNetCore.Components.Endpoints

<!DOCTYPE html>
<html lang="uk">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* AD-28: one bundle. css/app.css is compiled from Styles/app.scss at build time and
       carries the token layer, the themed Bootstrap build and the app-level rules. The
       scoped-CSS bundle below is the framework's, and is the only other stylesheet. *@
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["DriveTrack.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // AD-14: one global render mode, prerendering off, applied to <Routes> and <HeadOutlet>
    // — never to App.razor itself, which must stay statically rendered.
    private static readonly IComponentRenderMode InteractiveServerNoPrerender =
        new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Null for the handful of framework pages marked [ExcludeFromInteractiveRouting] — the
    // error and not-found pages, which need the cascading HttpContext and must not wait on a
    // circuit. Every routed screen gets the one global interactive mode.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServerNoPrerender : null;
}
