<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>drivetrack-web</UserSecretsId>
    <!--
      NFR-14: the neutral resources in this assembly *are* Ukrainian. Saying so stops the runtime
      probing for a uk satellite assembly that will never exist, and makes uk-UA resolve straight
      to the .resx files under Resources/.
    -->
    <NeutralResourcesLanguage>uk</NeutralResourcesLanguage>
    <!--
      AD-28: the theme is compiled from Sass at build time. The watcher is a dev-loop
      convenience that would otherwise copy a dart-sass runtime into bin/ and publish;
      with it off the package is build-only and the container image gains nothing.
    -->
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>
  </PropertyGroup>

  <!--
    AD-1: Web depends on Application, and on Domain because the caller shape it implements is
    typed in Domain identities - ICurrentUser answers UserId, DriverId, ClientId and UserRole, and
    the screens render the role. The direction is still inward, and the reference is declared rather
    than taken transitively so the layering test can pin it.
    The Infrastructure reference exists only so the composition root (Program.cs) can call
    AddInfrastructure; no other file under this project may name a DriveTrack.Infrastructure type.
    LayeringTests asserts that.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DriveTrack.Domain\DriveTrack.Domain.csproj" />
    <ProjectReference Include="..\DriveTrack.Application\DriveTrack.Application.csproj" />
    <ProjectReference Include="..\DriveTrack.Infrastructure\DriveTrack.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Compiles Styles/app.scss to wwwroot/css/app.css before the static web asset graph is
    resolved, so `dotnet build` alone produces the theme - no Node, no npm, no separate
    tool restore.

    PrivateAssets="all" stops the reference flowing to anything referencing this project, and
    keeps AspNetCore.SassCompiler.dll out of the publish output. It does NOT cover
    sasscompiler.json: that is a Content item of ours, not an asset of the package, so it is
    excluded from publish explicitly below. It is a build-time compiler configuration and the
    runtime image has no use for it.
  -->
  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.103.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="sasscompiler.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    The wire contract is asserted over HTTP by the integration suite, and the adapter that
    implements it is internal on purpose: nothing outside this assembly composes an envelope.
    The test project is the one exception.
  -->
  <!--
    The bearer handler is an adapter concern: Infrastructure signs a token, and this reads one back
    off an Authorization header. Application names neither (AD-1).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriveTrack.Integration.Tests" />
  </ItemGroup>

</Project>
