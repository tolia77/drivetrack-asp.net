<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>drivetrack-web</UserSecretsId>
    <!--
      NFR-14: the neutral resources in this assembly *are* Ukrainian. Saying so stops the runtime
      probing for a uk satellite assembly that will never exist, and makes uk-UA resolve straight
      to the .resx files under Resources/.
    -->
    <NeutralResourcesLanguage>uk</NeutralResourcesLanguage>
    <!--
      AD-28: the theme is compiled from Sass at build time, and the watcher keeps it compiled
      while the app runs. It was off because it copies a dart-sass runtime into bin/ and from
      there into the publish output, which the production image had no use for. There is no
      publish path any more - the only image is the development container, whose entrypoint is
      `dotnet watch` - so what the watcher costs is a runtime nothing ships and what it buys is
      an edit to a .scss file reaching the browser without a rebuild. Debug only, so a Release
      build is still build-only.
    -->
    <SassCompilerEnableWatcher Condition="'$(Configuration)' == 'Debug'">true</SassCompilerEnableWatcher>
    <SassCompilerEnableWatcher Condition="'$(Configuration)' != 'Debug'">false</SassCompilerEnableWatcher>
    <!--
      And with the watcher on, the compiler is a *runtime* dependency of this project rather than
      a build-time one, so its assembly has to reach anything that loads this one - the
      integration tests do, and a private reference leaves them throwing FileNotFoundException on
      every screen they render. Private in Release, where the watcher is off and the reference is
      build-only again.
    -->
    <SassCompilerAssets Condition="'$(Configuration)' == 'Debug'">none</SassCompilerAssets>
    <SassCompilerAssets Condition="'$(Configuration)' != 'Debug'">all</SassCompilerAssets>
  </PropertyGroup>

  <!--
    AD-1: Web depends on Application, and on Domain because the caller shape it implements is
    typed in Domain identities - ICurrentUser answers UserId, DriverId, ClientId and UserRole, and
    the screens render the role. The direction is still inward, and the reference is declared rather
    than taken transitively so the layering test can pin it.
    The Infrastructure reference exists only so the composition root (Program.cs) can call
    AddInfrastructure; no other file under this project may name a DriveTrack.Infrastructure type.
    LayeringTests asserts that.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DriveTrack.Domain\DriveTrack.Domain.csproj" />
    <ProjectReference Include="..\DriveTrack.Application\DriveTrack.Application.csproj" />
    <ProjectReference Include="..\DriveTrack.Infrastructure\DriveTrack.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Compiles Styles/app.scss to wwwroot/css/app.css before the static web asset graph is
    resolved, so `dotnet build` alone produces the theme - no Node, no npm, no separate
    tool restore.

    The privacy of the reference follows the watcher, through SassCompilerAssets above: private
    in Release, where this is a build-time compiler and its assembly belongs in nobody's output,
    and not private in Debug, where the watcher runs inside the application and every project
    that loads this one needs the assembly beside it.

    Neither setting covers sasscompiler.json: that is a Content item of ours, not an asset of the
    package, so it is excluded from publish explicitly below.
  -->
  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.103.0" PrivateAssets="$(SassCompilerAssets)" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="sasscompiler.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    The wire contract is asserted over HTTP by the integration suite, and the adapter that
    implements it is internal on purpose: nothing outside this assembly composes an envelope.
    The test project is the one exception.
  -->
  <!--
    The bearer handler is an adapter concern: Infrastructure signs a token, and this reads one back
    off an Authorization header. Application names neither (AD-1).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriveTrack.Integration.Tests" />
  </ItemGroup>

</Project>
